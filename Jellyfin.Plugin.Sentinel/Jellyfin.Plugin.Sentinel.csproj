<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.Sentinel</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.1.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Referenced directly (not just transitively via Microsoft.Data.Sqlite) because Plugin.cs
         needs a compile-time type from this assembly to register a custom native-library
         resolver — see the comment in Plugin.cs for why that resolver is required at all. -->
    <PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />
    <!-- Gives SentinelController compile-time access to ControllerBase/[ApiController]/[Authorize]
         without bundling any ASP.NET Core assemblies — FrameworkReference is never copied into the
         publish output, since Jellyfin's own host always provides this shared framework at runtime.
         Verified against the official jellyfin-plugin-playbackreporting's .csproj, which does the
         same thing for the same reason (it ships its own API controller). This also transitively
         provides Microsoft.Extensions.Hosting.Abstractions and
         Microsoft.Extensions.DependencyInjection.Abstractions (part of the ASP.NET Core shared
         framework), so the separate PackageReferences for those two — needed before this was
         added — would now trigger NuGet's NU1510 ("already available, remove the reference"). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
